# =============================================================================
# PyScribe IDE - Git Ignore Configuration
# =============================================================================

# --- Byte-compiled / Python artifacts ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# --- Virtual Environments ---
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# --- Build & Distribution outputs ---
build/
dist/
installer_output/
*.manifest

# Explicitly ensure PyInstaller spec and build scripts are version controlled:
!PyScribe.spec
!build_exe.bat
!installer/build_installer.bat
!installer/PyScribe.iss

# --- Runtime state, logs & user local configuration ---
session.pkl
projects.json
config/github_auth.json
# Agent chat sessions and other per-project PyScribe state.
.pyscribe/
logs/*.log
!logs/.gitkeep
scratch/

# --- IDEs and Text Editors ---
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# --- Operating System artifacts ---
Thumbs.db
desktop.ini
.DS_Store

# --- Testing & Code Quality caches ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.tox/
.nox/

# Local credentials, settings and development captures
/config/settings.json
/.env.*
!/.env.example
/nul
/screenshoots/agent_*.png
/build-release.log
/docs/ИДЕИ_ДЛЯ_ДИПЛОМА.md
